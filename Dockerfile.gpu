# =============================================================================
# GPU DOCKERFILE - UNIFIED PPE & 3D FACE RECOGNITION SYSTEM
# Optimized for NVIDIA CUDA 12.1 Acceleration with Automatic Fallback
# =============================================================================

FROM python:3.11-slim

# Environment variables for NVIDIA runtime
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

WORKDIR /app

# Install native system dependencies for OpenCV, dlib, PostgreSQL, and healthchecks
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    libopenblas-dev \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install PyTorch with NVIDIA CUDA 12.1 GPU acceleration
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cu121

# Install application dependencies
RUN pip install --no-cache-dir \
    ultralytics \
    opencv-python-headless \
    numpy \
    pandas \
    matplotlib \
    Pillow \
    PyYAML \
    tqdm \
    fastapi \
    "uvicorn[standard]" \
    python-multipart \
    psycopg2-binary \
    python-dotenv \
    websockets \
    mediapipe \
    dlib

# Copy application code and models
COPY backend/ /app/backend/
COPY Model/ /app/Model/

# Create directories for persistent runtime data
RUN mkdir -p /app/data/media /app/Datasets/Learned /app/runs

# Expose FastAPI backend port
EXPOSE 8001

# Healthcheck
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8001/api/health || exit 1

# Launch backend runner
CMD ["python", "backend/run.py"]
