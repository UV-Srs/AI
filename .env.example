# ============================================================
# DATABASE CONFIGURATION (PostgreSQL / SQLite)
# ============================================================
# Set DB_TYPE to 'postgres' to use PostgreSQL, or 'sqlite' for local SQLite
DB_TYPE=postgres

# PostgreSQL Connection Credentials
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ppe_compliance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Alternatively, specify a full connection string:
# DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/ppe_compliance

